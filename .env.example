# Use the SAME Firebase project as CarTracker / HomeTracker / ExpenseTracker.
# Household codes are shared across all four apps, so pointing this app at a
# different project would silently split the family's data in two.
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=my-autotrack-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=my-autotrack-app
VITE_FIREBASE_STORAGE_BUCKET=my-autotrack-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef...
